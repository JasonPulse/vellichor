<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Vellichor.Dat</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Godot's export builds with ExportDebug/ExportRelease; referenced non-Godot projects must define them. -->
    <Configurations>Debug;Release;ExportDebug;ExportRelease</Configurations>

    <!-- Publishable as a NuGet package so the DAT viewer (separate repo) consumes the shared decoders. -->
    <IsPackable>true</IsPackable>
    <PackageId>Vellichor.Dat</PackageId>
    <Authors>Vellichor</Authors>
    <Description>Pure-C# decoders for FINAL FANTASY XI on-disk DAT archives: FTABLE/VTABLE index, chunk containers, IMG textures, MMB/skinned models, skeletons and animations, plus retail-install detection. Reads a retail installation you own; ships no game data.</Description>
  </PropertyGroup>
</Project>
