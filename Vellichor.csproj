<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Vellichor</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Vellichor.Dat/Vellichor.Dat.csproj" />
    <ProjectReference Include="XiProtocol/XiProtocol.csproj" />
  </ItemGroup>

  <!-- Godot.NET.Sdk globs **/*.cs; exclude sibling projects so each compiles only its
       own sources (Wanehollow idiom). -->
  <ItemGroup>
    <Compile Remove="Vellichor.Dat/**/*.cs" />
    <Compile Remove="XiProtocol/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>
</Project>
