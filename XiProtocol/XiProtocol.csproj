<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Godot's export builds with ExportDebug/ExportRelease; referenced non-Godot projects must define them. -->
    <Configurations>Debug;Release;ExportDebug;ExportRelease</Configurations>

    <!-- Publishable as a NuGet package so the DAT viewer (separate repo) consumes the shared wire types. -->
    <IsPackable>true</IsPackable>
    <PackageId>Vellichor.XiProtocol</PackageId>
    <Authors>Vellichor</Authors>
    <Description>FFXI wire-protocol + world-state types (EntityLook, packets, session) shared from the XiHeadless stack.</Description>
  </PropertyGroup>

  <!--
    Shared FFXI wire-protocol + world-state. VENDORED from the XiHeadless bot into vendor/ so this
    repo builds standalone (CI has no access to the external repo, and the DAT-viewer handoff needs
    it self-contained). The bot-logic files (BotApi, QuestDefs, Vendors, HuntZones, PartyRoles) are
    intentionally NOT vendored — they depend on bot-layer enums and aren't wire/world-state.
    To resync: re-run the copy in vendor/README.md. The SDK's default **/*.cs glob compiles vendor/.
  -->

</Project>
